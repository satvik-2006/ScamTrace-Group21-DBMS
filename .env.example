# SQL is mandatory. SQLite is for local smoke tests only; use MySQL/PostgreSQL for submission.
DATABASE_URL=mysql+pymysql://scamtrace_app:URL_ENCODED_PASSWORD@127.0.0.1:3306/scamtrace
SCAMTRACE_SECRET_KEY=replace_with_random_secret_at_least_32_characters
COOKIE_SECURE=0
SCAMTRACE_SEED_DEMO=0

# NoSQL option 1: MongoDB stores unstructured evidence notes and provides text search.
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DATABASE=scamtrace_evidence
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
MYSQL_APP_PASSWORD=replace_with_a_strong_app_password
